      ) {
        column colPrjCode (attribute: Code, caption: 'Code', ColumnWidth: manual, Size: 100)
        column colPrjName (attribute: Name, caption: 'Name', ColumnWidth: manual, Size: 220)
        column colPrjDesc (attribute: "Description", caption: 'Description', WrapText: true, ColumnWidth: manual, Size: 300)
        column colPrjActive (attribute: IsActive, caption: 'Active', ColumnWidth: manual, Size: 80, Alignment: center)
        column colPrjAct (caption: ' ', ColumnWidth: manual, Size: 80) {
          actionbutton btnPrjEdit (caption: 'Edit', action: show_page IssueTracker.Project_NewEdit(Project: $currentObject))
        }
      }
    }
  }
}
/

create or replace page IssueTracker.Label_Overview
