      ) {
        column colLblN (attribute: Name, caption: 'Label', ColumnWidth: manual, Size: 220)
        column colLblColor (attribute: ColorClass, caption: 'Atlas colour class', ColumnWidth: manual, Size: 240)
        column colLblAct (caption: ' ', ColumnWidth: manual, Size: 80) {
          actionbutton btnLblEdit (caption: 'Edit', action: show_page IssueTracker.Label_NewEdit(Label: $currentObject))
        }
      }
    }
  }
}
/

-- -----------------------------------------------------------------------------
-- Workflow monitor (fills the phase-2 stub)
-- -----------------------------------------------------------------------------

create or modify page IssueTracker.WF_Overview
(
  title: 'Workflow monitor',
  layout: Atlas_Core.Atlas_Default,
  folder: 'Workflow',
  url: 'workflows'
)
{
  container ctnWfPage (class: 'it-page background-main') {
    container ctnWfHead (class: 'it-toolbar flex-column') {
      dynamictext txtWfEyebrow (content: 'Issue Handling', class: 'it-eyebrow')
      dynamictext txtWfTitle (content: 'Workflow monitor', rendermode: H2)
    }

    container ctnWfTasks (class: 'card it-card it-card--flush') {
      container ctnWfTasksHead (class: 'it-card-head flex-row align-x-between align-y-center') {
        dynamictext lblWfTasks (content: 'Open user tasks', class: 'it-section-label')
        dynamictext lblWfTasksHint (content: 'unfinished tasks across all issues', class: 'it-muted')
      }
      datagrid dgWfTasks (
        datasource: database from System.WorkflowUserTask where [EndTime = empty] sort by StartTime desc,
        PageSize: 15,
        class: 'datagrid-hover datagrid-lined datagrid-sm it-grid'
      ) {
        column colWfTaskName (attribute: Name, caption: 'Task', ColumnWidth: manual, Size: 200)
        column colWfTaskDesc (attribute: "Description", caption: 'Description', WrapText: true, ColumnWidth: manual, Size: 300)
        column colWfTaskDue (attribute: DueDate, caption: 'Due', ColumnWidth: manual, Size: 140)
        column colWfTaskStart (attribute: StartTime, caption: 'Started', ColumnWidth: manual, Size: 150)
        column colWfTaskOutcome (attribute: Outcome, caption: 'Outcome', ColumnWidth: manual, Size: 120)
      }
    }

    container ctnWfInstances (class: 'card it-card it-card--flush') {
      container ctnWfInstHead (class: 'it-card-head flex-row align-x-between align-y-center') {
        dynamictext lblWfInst (content: 'Workflow instances', class: 'it-section-label')
        dynamictext lblWfInstHint (content: 'newest first', class: 'it-muted')
      }
      datagrid dgWfInstances (
        datasource: database from System.Workflow sort by StartTime desc,
        PageSize: 15,
        class: 'datagrid-hover datagrid-lined datagrid-sm it-grid'
      ) {
        column colWfName (attribute: Name, caption: 'Instance', ColumnWidth: manual, Size: 220)
        column colWfStart (attribute: StartTime, caption: 'Started', ColumnWidth: manual, Size: 160)
        column colWfEnd (attribute: EndTime, caption: 'Ended', ColumnWidth: manual, Size: 160)
        column colWfDue (attribute: DueDate, caption: 'Due', ColumnWidth: manual, Size: 160)
      }
    }
  }
}
/
